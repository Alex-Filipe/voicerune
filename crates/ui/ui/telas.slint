export component JanelaPrincipal inherits Window {
    title: "VoiceRune";
    icon: @image-url("icone.svg");
    preferred-width: 400px;
    min-width: 380px;
    // Com vidro o véu vem só do retângulo abaixo (dois véus dobrariam a cor).
    background: Dados.vidro ? transparent : Cores.fundo;
    default-font-size: 13px;

    // Nunca usar ColorScheme.unknown: os widgets e as nossas cores divergiriam (texto some).
    // Antes do 1º ajuste o Palette segue o sistema; guardamos esse valor para "Do sistema".
    property <bool> sistema-escuro;
    property <bool> tema-forcado;
    public function aplicar-tema(t: int) {
        if !tema-forcado {
            sistema-escuro = Dados.sistema != 0 ? Dados.sistema == 2 : Palette.color-scheme == ColorScheme.dark;
            tema-forcado = true;
        }
        Palette.color-scheme = t == 1 ? ColorScheme.light : t == 2 ? ColorScheme.dark : sistema-escuro ? ColorScheme.dark : ColorScheme.light;
    }

    // Mudar `repintar` suja este fundo (a janela inteira) e força o redesenho completo; contorno
    // da janela vazia ao voltar de minimizada (ver `abrir_janela` no app).
    in property <int> repintar;
    Rectangle {
        width: 100%;
        height: 100%;
        background: repintar >= 0 ? Cores.fundo : Cores.fundo;
    }

    VerticalLayout {
        padding: 16px;
        padding-top: 16px + Dados.topo;
        // Só a página visível é instanciada (abre mais rápido, menos memória).
        if Dados.pagina == 0: PaginaInicio {
            // A lua do rodapé troca entre claro e escuro (Configurações → Tema volta ao do sistema).
            alternar-tema => {
                Dados.tema = Cores.escuro ? 1 : 2;
                root.aplicar-tema(Dados.tema);
                Dados.tema-escolhido();
            }
        }
        if Dados.pagina == 1: PaginaConfig {
            tema-mudou(t) => {
                root.aplicar-tema(t);
                Dados.tema-escolhido();
            }
        }
        if Dados.pagina == 2: PaginaSobre { }
        if Dados.pagina == 3: PaginaTeste { }
    }
}

// Ícone na barra de menus do Mac: sem menu, para o clique chegar ao app (com menu, a Slint 1.18 só
// abre o menu). Clique abre o flyout, que tem "Abrir ›" e "Sair".
export component BandejaSemMenu inherits SystemTrayIcon {
    icon: @image-url("icone.svg");
    tooltip: "VoiceRune";
    callback clicado();
    clicked => {
        root.clicado();
    }
}

// Ícone na bandeja (Shell_NotifyIconW no Windows): clique abre o flyout; botão direito, o menu.
export component Bandeja inherits SystemTrayIcon {
    icon: @image-url("icone.svg");
    tooltip: "VoiceRune";
    callback clicado();
    callback abrir();
    callback sair();
    clicked => {
        root.clicado();
    }
    Menu {
        MenuItem {
            title: "Abrir";
            activated => {
                root.abrir();
            }
        }

        MenuItem {
            title: "Sair";
            activated => {
                root.sair();
            }
        }
    }
}

export component Flyout inherits Window {
    title: "VoiceRune";
    // Mac: com moldura (escondida pelo app: barra transparente, sem botões); sem moldura o vidro do
    // sistema não aparece. Tem de valer já na criação: mudar depois faz a altura oscilar.
    no-frame: Platform.os != OperatingSystemType.macos;
    always-on-top: true;
    width: 320px;
    // Altura do conteúdo. No Windows, fixa (mínimo = máximo). No Mac, com folga: o conteúdo vai até
    // o topo (barra de título escondida) e o macOS mede os limites sem a barra (32 pt) enquanto o
    // winit mede o tamanho com ela; com mínimo = máximo a altura oscila sem parar.
    property <length> folga: Platform.os == OperatingSystemType.macos ? 40px : 0px;
    preferred-height: conteudo.preferred-height;
    min-height: conteudo.preferred-height - folga;
    max-height: conteudo.preferred-height + folga;
    // Lidas pelo Rust antes de mostrar, para encostar o flyout na barra de tarefas.
    out property <length> largura: self.width;
    out property <length> altura: conteudo.preferred-height;
    background: Cores.fundo;
    default-font-size: 13px;
    property <float> db: round(Dados.ganho-db);

    // Nunca usar ColorScheme.unknown: os widgets e as nossas cores divergiriam (texto some).
    // Antes do 1º ajuste o Palette segue o sistema; guardamos esse valor para "Do sistema".
    property <bool> sistema-escuro;
    property <bool> tema-forcado;
    public function aplicar-tema(t: int) {
        if !tema-forcado {
            sistema-escuro = Dados.sistema != 0 ? Dados.sistema == 2 : Palette.color-scheme == ColorScheme.dark;
            tema-forcado = true;
        }
        Palette.color-scheme = t == 1 ? ColorScheme.light : t == 2 ? ColorScheme.dark : sistema-escuro ? ColorScheme.dark : ColorScheme.light;
    }

    Rectangle {
        border-width: 1px;
        border-color: Cores.borda-janela;
        // Mac: o sistema arredonda os cantos da janela; o contorno some (fica o do sistema).
        visible: !Dados.vidro;
    }

    conteudo := VerticalLayout {
        padding: 14px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;
                Texto {
                    text: "Cancelamento de ruído";
                    font-size: 15px;
                    font-weight: 600;
                }

                Estado {
                    ligado: Dados.cancelamento;
                    erro: Dados.erro != "";
                    texto: Dados.erro != "" ? Dados.erro : !Dados.cancelamento ? "Desligado" : (Dados.modo == 0 ? "Leve" : "Forte") + " · " + Dados.atraso;
                }
            }

            VerticalLayout {
                alignment: center;
                BotaoEnergia {
                    width: 34px;
                    ligado: Dados.cancelamento;
                    clicado => {
                        Dados.cancelamento = !Dados.cancelamento;
                        Dados.cancelamento-mudou();
                    }
                }
            }
        }

        Medidor {
            nivel: Dados.nivel;
            nivel-limpo: Dados.nivel-limpo;
        }

        Segmentado {
            opcoes: ["Leve", "Forte", "Personalizado"];
            travadas: [false, false, true];
            habilitado: Dados.cancelamento;
            atual <=> Dados.modo;
            escolheu => {
                Dados.modo-escolhido();
            }
        }

        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Icone {
                    d: Icones.volume;
                    width: 14px;
                    height: 14px;
                    cor: Cores.texto3;
                }
            }

            Faixa {
                minimo: -12;
                maximo: 24;
                valor <=> Dados.ganho-db;
                mudou => {
                    Dados.ganho-mudou();
                }
            }

            Rotulo {
                width: 42px;
                horizontal-alignment: right;
                text: (db > 0 ? "+" : db < 0 ? "−" : "") + abs(db) + " dB";
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Rotulo {
                text: Dados.resumo-rota;
                horizontal-stretch: 1;
                // Nomes reais são longos ("Voicemeeter Out B1 (VB-Audio ...)"): corta com "…".
                overflow: elide;
            }

            if Dados.sair-no-flyout: Rotulo {
                text: "Sair";
                color: ta-sair.has-hover ? Cores.texto : Cores.texto2;
                accessible-role: button;
                ta-sair := TouchArea {
                    clicked => {
                        Dados.sair();
                    }
                }
            }

            Rotulo {
                text: "Abrir ›";
                font-weight: 600;
                color: ta-abrir.has-hover ? Cores.acento.darker(15%) : Cores.acento;
                accessible-role: button;
                ta-abrir := TouchArea {
                    clicked => {
                        Dados.abrir-janela();
                    }
                }
            }
        }
    }
}
