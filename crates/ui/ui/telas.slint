}

component PaginaSobre inherits VerticalLayout {
    spacing: 12px;
    alignment: start;
    CabecalhoPainel {
        titulo: "Sobre";
    }

    Grupo {
        VerticalLayout {
            padding: 12px;
            spacing: 4px;
            Texto {
                text: "VoiceRune " + Dados.versao;
                font-weight: 600;
            }

            Rotulo {
                text: "Cancelamento de ruído do microfone com IA, rodando no seu computador.";
                wrap: word-wrap;
            }
